# ---------------------------------------------------------------------------
# NEXA environment configuration
# Copy this file to `.env` and fill in the values you need.
# Every variable is validated at boot by packages/config — the process refuses
# to start with an invalid configuration rather than failing at request time.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
# Public origin of the web client. Used for CORS + links inside emails.
WEB_ORIGIN=http://localhost:5173

# --- Database ---------------------------------------------------------------
# driver: "pglite" runs a real PostgreSQL engine in-process (no server needed,
#         data persisted to DATABASE_DIR). Ideal for local dev + CI.
#         "postgres" connects to a normal PostgreSQL server via DATABASE_URL.
DATABASE_DRIVER=pglite
DATABASE_DIR=.pgdata
# Required when DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexa

# --- Auth -------------------------------------------------------------------
# 32+ char random string. Generate: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
AUTH_SECRET=change-me-to-a-long-random-value-at-least-32-chars
SESSION_TTL_DAYS=30
# Set to true when serving over HTTPS (forces Secure cookies).
COOKIE_SECURE=false

# --- AI ---------------------------------------------------------------------
# provider: "mock" = deterministic development adapter driven by real seeded
#           data (no API key needed). "anthropic" = production provider.
AI_PROVIDER=mock

# Your key from console.anthropic.com. Required only when AI_PROVIDER=anthropic.
# Never commit this file with a real key in it.
# After setting it, run `npm run ai:verify` to confirm the wiring end to end.
AI_API_KEY=

# claude-opus-5      — strongest reasoning; the default.
# claude-sonnet-5    — near-Opus quality at ~60% of the cost. Good for volume.
# claude-haiku-4-5   — cheapest and fastest; fine for simple lookups.
AI_MODEL=claude-opus-5

# Ceiling on a single response, thinking tokens included.
AI_MAX_TOKENS=4096

# How hard the model works before answering: low | medium | high | xhigh | max.
# "medium" is the balance point for a business assistant — raise it if answers
# feel shallow on multi-step questions, lower it if turns feel slow or costly.
AI_EFFORT=medium

# Adaptive thinking: the model decides per question how much reasoning it needs.
# Turning this off trades answer quality for lower latency and spend.
AI_THINKING=true

AI_MAX_RETRIES=2
AI_TIMEOUT_MS=120000

# Guard rail, not a billing system. Once a business's *estimated* AI spend for
# the calendar month reaches this many US cents, further turns are refused with
# a clear message until the month rolls over. 0 = no ceiling.
# Example: 2000 = $20.00 per business per month.
AI_MONTHLY_BUDGET_CENTS=0

# --- Email / SMS / WhatsApp -------------------------------------------------
# "console" writes messages to the server log and the outbox table instead of
# delivering them. Never pretends a real send happened.
# "smtp" delivers for real via the SMTP_* settings below — works with Postmark,
# SES, Resend, Mailgun, Brevo, or a mail server you run yourself.
EMAIL_PROVIDER=console
EMAIL_FROM=nexa@example.com
EMAIL_PROVIDER_KEY=

# Required when EMAIL_PROVIDER=smtp.
# Port 587 with SMTP_SECURE=false uses STARTTLS (the usual choice);
# port 465 needs SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

SMS_PROVIDER=console
SMS_PROVIDER_KEY=
WHATSAPP_PROVIDER=console
WHATSAPP_PROVIDER_KEY=

# --- Payments ---------------------------------------------------------------
# "mock"     — no money moves; every result is flagged simulated in the UI.
# "paystack" — GHS/NGN/KES/ZAR incl. mobile money. The right default for
#              West Africa, where most customers do not pay by card.
# "stripe"   — international card payments.
PAYMENT_PROVIDER=mock

# Paystack: the secret key (sk_live_… / sk_test_…).
# Stripe:   the secret key (sk_live_… / sk_test_…).
PAYMENT_PROVIDER_KEY=

# REQUIRED for any live provider — the app refuses to boot without it.
# Paystack: your secret key again (Paystack signs with it).
# Stripe:   the endpoint signing secret (whsec_…) from the webhook settings.
# Without this, anyone who finds the webhook URL could mark invoices paid.
PAYMENT_WEBHOOK_SECRET=

# Where the payer is returned after a hosted checkout. Point it at the web app.
# A redirect here is NEVER treated as proof of payment — only the signed
# webhook settles an invoice.
PAYMENT_CALLBACK_URL=http://localhost:5173/payment-complete

# Point your gateway's webhook at:  https://<your-api-host>/webhooks/payments

# --- Operational ------------------------------------------------------------
# Runs the proactive agents in this process: the monitoring scans, the daily
# Morning Brief (delivered at 07:00 in each business's own timezone), and
# expiry of AI proposals nobody decided on.
# Safe to leave on with several instances — each job takes a PostgreSQL
# advisory lock, so exactly one instance executes any given run.
WORKER_ENABLED=true

LOG_LEVEL=info
RATE_LIMIT_ENABLED=true
# Loads the AURA BEAUTY GH demo workspace on `npm run db:seed`.
SEED_DEMO_DATA=true
