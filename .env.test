# Environment for the automated test suite.
# Loaded via `node --env-file=.env.test`, which takes precedence over .env.
NODE_ENV=test
DATABASE_DRIVER=pglite
DATABASE_DIR=.pgdata-test
AUTH_SECRET=test-secret-value-that-is-long-enough-32
AI_PROVIDER=mock
EMAIL_PROVIDER=console
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
PAYMENT_PROVIDER=mock
# Rate limits would make the suite flaky and prove nothing about the domain.
RATE_LIMIT_ENABLED=false
LOG_LEVEL=error
SEED_DEMO_DATA=false
