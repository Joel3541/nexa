  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@nexa/config": "*",
    "@nexa/types": "*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.3"
  }
}
